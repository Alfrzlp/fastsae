PKG_LIBS = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)
PKG_CXXFLAGS += $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS += $(SHLIB_OPENMP_CXXFLAGS)

## Strip debug symbols after build (same purpose as in Makevars; Windows
## toolchain always uses GNU Make via Rtools, so += etc. here is fine).
.PHONY: all

all: $(SHLIB)

strippedLib: $(SHLIB)
	if test -e "$(SHLIB)"; then $(STRIP) --strip-debug $(SHLIB); fi
